# Groq API key, used to write the notes for each pick
GROQ_API_KEY=your_key_here

# Optional: Groq models to try, best first (comma-separated)
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional: only needed to run src/supabase_sync.py locally
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your_secret_key
# SYNC_SECRET=any_long_random_string
# SYNC_SECRET also lets scripts/run_evals.py skip the Scout and Ask hourly limits

# Optional: pick from yesterday's papers, whose upvotes have had a day to build up
# PICK_FROM=yesterday

# Optional: turn off the LLM judge and pick by score alone
# PICK_JUDGE=off

# Optional: how many top-scored papers the judge compares (default 6)
# JUDGE_SHORTLIST=6

# Optional: trace each daily run in LangSmith (free developer plan)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=ai-paper-daily

# Optional: daily email through Buttondown (send_newsletter.py)
# BUTTONDOWN_API_KEY=your_buttondown_key
# BUTTONDOWN_SEND=draft            # "draft" saves the email instead of sending it
# BUTTONDOWN_USER=your_username    # shows the email sign-up box on the site
# SITE_URL=https://omen-bit.github.io/ai-paper-daily/

# Optional: site extras, added only when set
# UMAMI_WEBSITE_ID=your_umami_id
# GOOGLE_SITE_VERIFICATION=content_of_the_google_meta_tag

# Optional: better lab names and logos (paper_links.py, lab_logos.py)
# OPENALEX_API_KEY=your_openalex_key
# LOGO_DEV_TOKEN=your_logo_dev_token
# GITHUB_TOKEN=a_read_only_token   # higher GitHub API limits; Actions sets it for you
